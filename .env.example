# Скопируйте в .env. Настоящие значения не добавляются в Git.
SQB_DB_PASSWORD=sqb
# Отдельная база документов, для сервера сменить пароль.
KNOWLEDGE_DB_PASSWORD=knowledge-local-only
# Общий секрет Hub и сервиса документов: не менее 32 случайных символов.
# Генерация: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SQB_KNOWLEDGE_SECRET=
# Nova Platform (https://nova.example.internal/docs): её RAG-сервис — поиск по базе
# положений и модель. Ключ nova_… создаётся на https://nova.example.internal/keys.
# Без адреса и ключа подключение выключено.
# Адрес RAG-сервиса (без /v1), с сервера банка — http://nova-gateway.internal:11450/api/v1/services/rag.
NOVA_BASE_URL=
NOVA_API_KEY=
NOVA_COLLECTION=ops_policies
# Прокси только для запросов к Nova, если прямого доступа с сервера нет,
# например http://preview-server.internal:8181. Пусто — напрямую.
NOVA_PROXY=
# Подключение Process Hub (backend/app/services/nova): не больше запросов сразу
# и тайм-аут ответа, с; 1 в NOVA_FAKE — заглушка без сети (разработка).
NOVA_MAX_PARALLEL=2
NOVA_TIMEOUT=300
NOVA_FAKE=
# Быстрый вход в один клик под этим аккаунтом @sqb.uz — ТОЛЬКО для тестового
# стенда и демонстраций. На рабочем сервере оставьте пустым.
SQB_DEMO_LOGIN=
# Сервер в Docker: порты наружу (пусто — только эта машина: 127.0.0.1:8080 и :8000)
# и модуль «Документы» (профиль knowledge) вместе с остальными службами.
# SQB_WEB_PORT=3000
# SQB_API_PORT=8080
# COMPOSE_PROFILES=knowledge
# Только без Docker (корпоративный компьютер, scripts\*.ps1): адреса баз в
# установленном PostgreSQL и API документов. Docker задаёт их сам.
# SQB_DATABASE_URL=postgresql://sqb:ПАРОЛЬ@localhost:5432/sqb
# KNOWLEDGE_DATABASE_URL=postgresql://knowledge:ПАРОЛЬ@localhost:5432/knowledge
# SQB_KNOWLEDGE_URL=http://127.0.0.1:8010
