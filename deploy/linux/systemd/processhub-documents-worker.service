# Подготовка загруженных файлов (извлечение текста). Ключ Nova этой службе не нужен.
[Unit]
Description=Process Hub: подготовка файлов документов
After=network-online.target
Wants=network-online.target
PartOf=processhub.target
StartLimitIntervalSec=0

[Service]
User=knowledge
Group=knowledge
WorkingDirectory=/opt/processhub/knowledge
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/processhub/documents.env
UnsetEnvironment=NOVA_API_KEY NOVA_BASE_URL
ExecStart=/opt/processhub/venv/bin/python -m knowledge_service.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=processhub.target
