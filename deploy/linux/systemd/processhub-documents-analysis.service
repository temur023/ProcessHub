# Анализ инструкций через Nova: один запуск за раз (у ключа Nova лимит одновременных запросов).
[Unit]
Description=Process Hub: анализ документов через Nova
After=network-online.target
Wants=network-online.target
PartOf=processhub.target
StartLimitIntervalSec=0

[Service]
User=knowledge
Group=knowledge
WorkingDirectory=/opt/processhub/knowledge
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/processhub/documents.env
ExecStart=/opt/processhub/venv/bin/python -m knowledge_service.analysis_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=processhub.target
