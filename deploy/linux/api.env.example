# Настройки API платформы (служба processhub-api). На сервере: /etc/processhub/api.env,
# права 640, владелец root:sqb. install.sh создаёт файл при первой установке и больше
# его не трогает. Пароли и ключи сюда вписывают на сервере; в Git они не попадают.

# База платформы на сервере БД. Пароль с символами @ : / % # ? записывается
# в URL-кодировке (например, @ -> %40). Порт — уточнить у администраторов БД.
SQB_DATABASE_URL=postgresql://sqb:CHANGE_ME@db-server.internal:5432/sqb

# Общий секрет с сервисом документов. install.sh создаёт его сам, одинаковым
# в api.env и documents.env; менять — только в обоих файлах сразу.
SQB_KNOWLEDGE_SECRET=@SECRET@

# Nova Platform: адрес её RAG-сервиса (без /v1), ключ nova_… — с https://nova.example.internal/keys.
# Без ключа анализ через Nova выключен, остальное работает.
NOVA_BASE_URL=http://nova-gateway.internal:11450/api/v1/services/rag
NOVA_API_KEY=
NOVA_COLLECTION=ops_policies
# Прокси только для запросов к Nova, если прямого доступа нет (http://host:port). Пусто — напрямую.
NOVA_PROXY=
NOVA_MAX_PARALLEL=2
NOVA_TIMEOUT=300
