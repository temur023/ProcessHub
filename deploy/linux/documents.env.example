# Настройки модуля «Документы» (службы processhub-documents*). На сервере:
# /etc/processhub/documents.env, права 640, владелец root:knowledge. install.sh
# создаёт файл при первой установке и больше его не трогает.

# Отдельная база документов. Пароль — в URL-кодировке, как в api.env.
KNOWLEDGE_DATABASE_URL=postgresql://knowledge:CHANGE_ME@db-server.internal:5432/knowledge

# Тот же секрет, что в api.env.
SQB_KNOWLEDGE_SECRET=@SECRET@

# Nova — те же значения, что в api.env. Обработчику файлов ключ не передаётся.
NOVA_BASE_URL=http://nova-gateway.internal:11450/api/v1/services/rag
NOVA_API_KEY=
NOVA_COLLECTION=ops_policies
NOVA_PROXY=

# Просмотр Word (служба processhub-preview). Пусто, если LibreOffice не установлен.
DOCUMENT_PREVIEW_URL=@PREVIEW_URL@
